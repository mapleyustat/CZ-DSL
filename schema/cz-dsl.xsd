<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================ -->
<!-- CZ-DSL 1.0 XML Schema                                        -->
<!-- 海岸带领域描述语言 1.0 XML Schema 定义                        -->
<!-- 基于 KML / CityGML / GML 设计范式                             -->
<!-- targetNamespace: http://cz-dsl.org/schema/1.0                  -->
<!-- ============================================================ -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cz="http://cz-dsl.org/schema/1.0"
           targetNamespace="http://cz-dsl.org/schema/1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="2.0">

  <!-- ======================================================== -->
  <!-- 第一部分：基础类型定义                                     -->
  <!-- 基础类型：单位、不确定性、坐标参考、时间参考               -->
  <!-- ======================================================== -->

  <!-- 单位类型 —— 支持 SI 量纲属性，用于单位一致性校验 -->
  <xs:complexType name="UnitType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        单位类型，携带 SI 量纲属性（长度、质量、时间、电流、温度、物质的量、发光强度），
        供运行时进行单位一致性校验。
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="siLength" type="xs:integer" default="0"/>
        <xs:attribute name="siMass" type="xs:integer" default="0"/>
        <xs:attribute name="siTime" type="xs:integer" default="0"/>
        <xs:attribute name="siCurrent" type="xs:integer" default="0"/>
        <xs:attribute name="siTemperature" type="xs:integer" default="0"/>
        <xs:attribute name="siAmount" type="xs:integer" default="0"/>
        <xs:attribute name="siLuminosity" type="xs:integer" default="0"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- 不确定性类型 —— 支持高斯/均匀/对数正态/经验分布 -->
  <xs:complexType name="UncertaintyType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        不确定性建模类型，支持 Gaussian、Uniform、LogNormal、Empirical 等分布，
        用于数据质量与模型置信度量化。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Distribution" minOccurs="1" maxOccurs="1">
        <xs:complexType>
          <xs:attribute name="type" use="required">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:enumeration value="Gaussian"/>
                <xs:enumeration value="Uniform"/>
                <xs:enumeration value="LogNormal"/>
                <xs:enumeration value="Empirical"/>
                <xs:enumeration value="Categorical"/>
              </xs:restriction>
            </xs:simpleType>
          </xs:attribute>
          <xs:attribute name="mean" type="xs:double" use="optional"/>
          <xs:attribute name="std" type="xs:double" use="optional"/>
          <xs:attribute name="min" type="xs:double" use="optional"/>
          <xs:attribute name="max" type="xs:double" use="optional"/>
          <xs:attribute name="median" type="xs:double" use="optional"/>
          <xs:attribute name="confidence" type="xs:double" use="optional"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="confidenceInterval" type="xs:double" default="0.95"/>
  </xs:complexType>

  <!-- 坐标参考类型 —— 支持任意 CRS：EPSG 代码 + WKT + 动态参数 -->
  <xs:complexType name="CoordinateReferenceType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        坐标参考系统类型，支持通过 EPSG 代码、WKT 定义以及动态参数（如潮汐基准、历元）
        描述任意 CRS，兼容 SEDRIS SRM。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="EPSG" type="xs:integer" minOccurs="0" maxOccurs="1"/>
      <xs:element name="WKT" type="xs:string" minOccurs="0" maxOccurs="1"/>
      <xs:element name="DynamicParameters" minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Epoch" type="xs:string" minOccurs="0"/>
            <xs:element name="TidalDatum" type="xs:string" minOccurs="0"/>
            <xs:element name="GeoidModel" type="xs:string" minOccurs="0"/>
            <xs:element name="Origin" type="cz:Point3DType" minOccurs="0"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="optional"/>
    <xs:attribute name="srmMapping" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- 三维点类型 -->
  <xs:complexType name="Point3DType">
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="z" type="xs:double" use="optional"/>
  </xs:complexType>

  <!-- 时间参考类型 —— 日历 + 历元 + 分辨率 -->
  <xs:complexType name="TemporalReferenceType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        时间参考类型，包含日历系统、时间历元与时间分辨率。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Calendar" type="xs:string" default="Gregorian" minOccurs="0"/>
      <xs:element name="Epoch" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="Resolution" type="cz:UnitType" minOccurs="0"/>
      <xs:element name="TimeZone" type="xs:string" default="UTC" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ======================================================== -->
  <!-- 第二部分：AtomType 抽象基类与扩展机制                       -->
  <!-- AtomType 是所有原子的抽象基类，提供插件式扩展基础           -->
  <!-- ======================================================== -->

  <xs:complexType name="AtomType" abstract="true">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        AtomType —— 所有原子元素的抽象基类。
        提供 id、version、extends、source 四个通用属性，实现插件式扩展机制。
        所有具体原子类型必须继承本类型。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ExtensionSlot" type="cz:ExtensionSlotType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="version" type="xs:string" default="1.0.0"/>
    <xs:attribute name="extends" type="xs:string" use="optional"/>
    <xs:attribute name="source" type="xs:string" use="optional"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- ExtensionSlot —— 无侵入式扩展槽 -->
  <xs:complexType name="ExtensionSlotType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        ExtensionSlot 扩展槽类型：通过 xs:any (processContents=lax) 和 anyAttribute
        提供无侵入式扩展机制，新原子/数据类型/模型接口可在不修改核心 schema 的前提下插入。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- ======================================================== -->
  <!-- 第三部分：四级分类层次类型                                 -->
  <!-- LayeredClassification 组件: WholeDomain / CoastalCell /    -->
  <!-- CorePatch / BaseElement                                   -->
  <!-- ======================================================== -->

  <xs:simpleType name="ClassificationLevelType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="WholeDomain"/>
      <xs:enumeration value="CoastalCell"/>
      <xs:enumeration value="CorePatch"/>
      <xs:enumeration value="BaseElement"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 分类编码模式: CZ.WD.* / CZ.CC.* / CZ.CP.* / CZ.BE.* -->
  <xs:simpleType name="ClassificationCodeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="CZ\.(WD|CC|CP|BE)\.[A-Z0-9-]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ClassificationLayerType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        四级分类层类型，level 属性枚举为 WholeDomain/CoastalCell/CorePatch/BaseElement，
        code 遵循 CZ.(WD|CC|CP|BE).* 模式，cmecsRef/edcsRef 提供与 CMECS/EDCS 的交叉引用。
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="Level" type="cz:ClassificationLevelType"/>
          <xs:element name="Code" type="cz:ClassificationCodeType"/>
          <xs:element name="Label" type="xs:string" minOccurs="0"/>
          <xs:element name="CmecsRef" type="xs:string" minOccurs="0"/>
          <xs:element name="EdcsRef" type="xs:string" minOccurs="0"/>
          <xs:element name="ParentCode" type="cz:ClassificationCodeType" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ======================================================== -->
  <!-- 第四部分：七大组件的原子类型定义                            -->
  <!-- 每个组件组（group）包含若干可插拔原子元素                   -->
  <!-- ======================================================== -->

  <!-- 4.1 DataAccess 组件原子 -->
  <xs:complexType name="DataSourceType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="Protocol" type="xs:string" minOccurs="0"/>
          <xs:element name="Endpoint" type="xs:string" minOccurs="0"/>
          <xs:element name="Format" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="CoordinateReferenceAtomType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="CRS" type="cz:CoordinateReferenceType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="TemporalReferenceAtomType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="Temporal" type="cz:TemporalReferenceType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ResolutionSpecType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="SpatialResolution" type="cz:UnitType" minOccurs="0"/>
          <xs:element name="TemporalResolution" type="cz:UnitType" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="QualityProfileType">
