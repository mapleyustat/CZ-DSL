  </xs:complexType>

  <!-- ======================================================== -->
  <!-- 第五部分：七大组件组 (xs:group) 定义                        -->
  <!-- 每个组包含该组件下的所有可插拔原子                          -->
  <!-- ======================================================== -->

  <!-- 组件 1: DataAccess -->
  <xs:group name="DataAccessGroup">
    <xs:sequence>
      <xs:element name="DataSource" type="cz:DataSourceType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="CoordinateReference" type="cz:CoordinateReferenceAtomType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="TemporalReference" type="cz:TemporalReferenceAtomType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ResolutionSpec" type="cz:ResolutionSpecType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="QualityProfile" type="cz:QualityProfileType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="UncertaintyModel" type="cz:UncertaintyModelType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="AccessEndpoint" type="cz:AccessEndpointType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 2: ModelAdapter -->
  <xs:group name="ModelAdapterGroup">
    <xs:sequence>
      <xs:element name="ModelInterface" type="cz:ModelInterfaceType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ModelCapability" type="cz:ModelCapabilityType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ModelIOContract" type="cz:ModelIOContractType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ModelVersion" type="cz:ModelVersionType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ModelDeployment" type="cz:ModelDeploymentType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ModelInvokeBinding" type="cz:ModelInvokeBindingType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 3: CrossSubjectLink -->
  <xs:group name="CrossSubjectLinkGroup">
    <xs:sequence>
      <xs:element name="Subject" type="cz:SubjectType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Role" type="cz:RoleType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Jurisdiction" type="cz:JurisdictionType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="SemanticLink" type="cz:SemanticLinkType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Provenance" type="cz:ProvenanceType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Authorization" type="cz:AuthorizationType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Responsibility" type="cz:ResponsibilityType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 4: LLMDispatch -->
  <xs:group name="LLMDispatchGroup">
    <xs:sequence>
      <xs:element name="LLMTask" type="cz:LLMTaskType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="PromptContract" type="cz:PromptContractType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="SpatialCognitionCall" type="cz:SpatialCognitionCallType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="LogicInferenceCall" type="cz:LogicInferenceCallType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="LLMOutputBinding" type="cz:LLMOutputBindingType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="GroundingConstraint" type="cz:GroundingConstraintType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="HallucinationGuard" type="cz:HallucinationGuardType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 5: GranularityPartition -->
  <xs:group name="GranularityPartitionGroup">
    <xs:sequence>
      <xs:element name="GranularityLevel" type="cz:GranularityLevelType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="PartitionRule" type="cz:PartitionRuleType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="AggregationOperator" type="cz:AggregationOperatorType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="DisaggregationOperator" type="cz:DisaggregationOperatorType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="BoundaryRule" type="cz:BoundaryRuleType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 6: LayeredClassification -->
  <xs:group name="LayeredClassificationGroup">
    <xs:sequence>
      <xs:element name="ClassificationLayer" type="cz:ClassificationLayerType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- 组件 7: DigitalTwinMapping -->
  <xs:group name="DigitalTwinMappingGroup">
    <xs:sequence>
      <xs:element name="PhysicalAsset" type="cz:PhysicalAssetType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="DigitalReplica" type="cz:DigitalReplicaType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="AssimilationBinding" type="cz:AssimilationBindingType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="SimulationBinding" type="cz:SimulationBindingType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="FeedbackControl" type="cz:FeedbackControlType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="StateVariable" type="cz:StateVariableType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ObservationStream" type="cz:ObservationStreamType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- ======================================================== -->
  <!-- 第六部分：根元素 CZScenario 与顶级类型                      -->
  <!-- ======================================================== -->

  <!-- 场景元数据类型 -->
  <xs:complexType name="MetadataType">
    <xs:sequence>
      <xs:element name="Title" type="xs:string"/>
      <xs:element name="Description" type="xs:string" minOccurs="0"/>
      <xs:element name="Author" type="xs:string" minOccurs="0"/>
      <xs:element name="Created" type="xs:dateTime" minOccurs="0"/>
      <xs:element name="Version" type="xs:string" minOccurs="0"/>
      <xs:element name="Tags" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- 粒度类型 (4-level) -->
  <xs:complexType name="GranularityType">
    <xs:sequence>
      <xs:element name="Level" type="cz:ClassificationLevelType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- CZScenario 根类型 -->
  <xs:complexType name="CZScenarioType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        CZScenario 根类型 —— 海岸带场景的顶级容器，
        包含 metadata、spatialReference、temporalReference、granularity 及七大组件组。
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="metadata" type="cz:MetadataType"/>
      <xs:element name="spatialReference" type="cz:CoordinateReferenceType"/>
      <xs:element name="temporalReference" type="cz:TemporalReferenceType"/>
      <xs:element name="granularity" type="cz:GranularityType"/>

      <!-- 七大组件组 -->
      <xs:element name="DataAccess">
        <xs:complexType>
          <xs:group ref="cz:DataAccessGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="ModelAdapter">
        <xs:complexType>
          <xs:group ref="cz:ModelAdapterGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="CrossSubjectLink">
        <xs:complexType>
          <xs:group ref="cz:CrossSubjectLinkGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="LLMDispatch">
        <xs:complexType>
          <xs:group ref="cz:LLMDispatchGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="GranularityPartition">
        <xs:complexType>
          <xs:group ref="cz:GranularityPartitionGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="LayeredClassification">
        <xs:complexType>
          <xs:group ref="cz:LayeredClassificationGroup"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="DigitalTwinMapping">
        <xs:complexType>
          <xs:group ref="cz:DigitalTwinMappingGroup"/>
        </xs:complexType>
      </xs:element>

      <!-- 全局扩展槽：允许在任何位置插入扩展内容 -->
      <xs:element name="ExtensionSlot" type="cz:ExtensionSlotType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="version" type="xs:string" default="2.0"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- 根元素 CZScenario -->
  <xs:element name="CZScenario" type="cz:CZScenarioType">
    <xs:annotation>
      <xs:documentation xml:lang="zh">
        CZScenario 根元素 —— 海岸带领域描述语言 1.0 的 XML 序列化根节点。
      </xs:documentation>
    </xs:annotation>
  </xs:element>

</xs:schema>
