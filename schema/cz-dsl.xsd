      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="Level" type="xs:string" minOccurs="0"/>
          <xs:element name="Standard" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="UncertaintyModelType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="Uncertainty" type="cz:UncertaintyType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="AccessEndpointType">
    <xs:complexContent>
      <xs:extension base="cz:AtomType">
        <xs:sequence>
          <xs:element name="URL" type="xs:anyURI"/>
          <xs:element name="AuthMethod" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

