  "LLMDispatch": {
    "LLMTask": [
      {
        "id": "llm-slr-projection",
        "version": "1.0.0",
        "taskType": "SLR_projection",
        "description": "基于历史验潮站与卫星测高数据，使用LLM生成2050年杭州湾海平面上升预测及叙述性说明"
      }
    ],
    "PromptContract": [
      {
        "id": "pc-slr-projection",
        "version": "1.0.0",
        "systemPrompt": "你是一位海岸带海洋学家。基于提供的历史潮位数据，预测杭州湾2050年海平面上升值，并给出置信区间。所有数值必须引用数据来源。",
        "userPrompt": "请基于杭州湾1990-2025年验潮站月均海平面数据（来源: ds-tide-gauge）和卫星测高数据（来源: ds-satellite-altimetry），预测2050年相对海平面上升值（单位: meter），给出95%置信区间。"
      }
    ],
    "SpatialCognitionCall": [
      {
        "id": "scc-hzb-inundation",
        "version": "1.0.0",
        "query": "识别杭州湾0.5m海平面上升下的淹没风险区域",
        "region": "120.8E-122.0E, 30.0N-31.0N"
      }
    ],
    "LogicInferenceCall": [
      {
        "id": "lic-adaptation-reasoning",
        "version": "1.0.0",
        "premise": "如果2050年SLR=0.52m且现有海堤堤顶高程=6.5m且百年一遇风暴潮增水=2.3m",
        "conclusion": "则海堤安全裕度=3.68m，满足1-in-100-year防洪标准"
      }
    ],
    "LLMOutputBinding": [
      {
        "id": "lob-slr-value",
        "version": "1.0.0",
        "targetField": "drivers.sea_level_rise",
        "transform": "extract_numeric_value"
      }
    ],
    "GroundingConstraint": [
      {
        "id": "gc-tide-gauge",
        "version": "1.0.0",
        "constraint": "LLM输出的SLR值必须落在验潮站观测数据外推范围内（0.3-0.8m）",
        "dataSourceRef": "ds-tide-gauge"
      }
    ],
    "HallucinationGuard": [
      {
        "id": "hg-numeric-check",
        "version": "1.0.0",
        "strategy": "numeric_range_validation",
        "threshold": 0.15
      }
    ]
  },

