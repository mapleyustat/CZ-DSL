data ISO19115_Metadata {
    fileIdentifier: String,
    language: LanguageCode with default "eng",
    characterSet: CharacterSetCode with default "UTF8",
    hierarchyLevel: Array<ScopeCode>,
    contact: Array<ResponsibleParty>,
    dateStamp: DateTime,
    
    metadataStandardName: String with default 
        "ISO 19115-2 Geographic Information - Metadata Part 2",
    metadataStandardVersion: String with default 
        "ISO 19115-2:2009(E)",
    
    spatialRepresentationInfo: Array<SpatialRepresentation>,
    identificationInfo: DataIdentification,
    dataQualityInfo: DataQuality,
    distributionInfo: Distribution
}

data ResponsibleParty {
    individualName: String,
    organisationName: String,
    contactInfo: ContactInfo,
    role: RoleCode
}

data GeographicExtent {
    westBoundLongitude: Real with unit degree,
    eastBoundLongitude: Real with unit degree,
    southBoundLatitude: Real with unit degree,
    northBoundLatitude: Real with unit degree,
    
    constraint BoundingBox {
        westBoundLongitude >= -180.0,
        eastBoundLongitude <= 180.0,
        southBoundLatitude >= -90.0,
        northBoundLatitude <= 90.0,
        westBoundLongitude < eastBoundLongitude,
        southBoundLatitude < northBoundLatitude
    }
}

data ACDDMetadata {
    // Required attributes
    title: String,
    summary: String,
    keywords: String,
    
    // Creator information
    creator_name: String,
    creator_email: String,
    creator_institution: String,
    
    // Time coverage
    time_coverage_start: DateTime,
    time_coverage_end: DateTime,
    time_coverage_resolution: String,  // ISO 8601 duration
    
    // Geographic coverage with physical units
    geospatial_lat_min: Real with unit degree,
    geospatial_lat_max: Real with unit degree,
    geospatial_lon_min: Real with unit degree,
    geospatial_lon_max: Real with unit degree,
    geospatial_vertical_min: Real with unit meter,
    geospatial_vertical_max: Real with unit meter,
    
    // Standards
    Conventions: String,  // e.g., "CF-1.6, SGRID-0.1, ACDD-1.3"
    cdm_data_type: String  // e.g., "Grid", "Station"
}

data CFVariableAttributes {
    standard_name: String,  // From CF standard name table
    long_name: String,
    units: String,
    
    // Missing values
    missing_value: Real,
    _FillValue: Real,
    valid_min: Real,
    valid_max: Real,
    
    // Coverage content type
    coverage_content_type: String,  // "modelResult", etc.
    
    // Grid association
    grid: String,
    coordinates: String
}

process NetCDF2ISOConversion {
    inputs: {
        netcdf_file: String,
        ncml_file: String,
        xsl_stylesheet: String
    },
    
    outputs: {
        iso_xml: String,
        metadata_score: Real
    },
    
    steps: {
        step1_read_netcdf: {
            global_attributes = extract_global_attributes(netcdf_file),
            variable_attributes = extract_variable_attributes(netcdf_file),
            dimensions = extract_dimensions(netcdf_file)
        },
        
        step2_apply_ncml: {
            if ncml_file exists {
                enhanced_metadata = merge_ncml_attributes(
                    global_attributes, ncml_file
                )
            }
        },
        
        step3_map_to_iso: {
            // Map ACDD to ISO elements
            fileIdentifier = generate_uuid(),
            title = enhanced_metadata.title,
            abstract = enhanced_metadata.summary,
            
            creator = map_to_responsible_party(
                name: enhanced_metadata.creator_name,
                email: enhanced_metadata.creator_email,
                role: "originator"
            ),
            
            geographicExtent = GeographicExtent {
                westBoundLongitude: 
                    enhanced_metadata.geospatial_lon_min,
                eastBoundLongitude: 
                    enhanced_metadata.geospatial_lon_max,
                southBoundLatitude: 
                    enhanced_metadata.geospatial_lat_min,
                northBoundLatitude: 
                    enhanced_metadata.geospatial_lat_max
            }
        },
        
        step4_xsl_transform: {
            iso_xml = xslt_transform(
                source: step3_map_to_iso,
                stylesheet: xsl_stylesheet
            )
        },
        
        step5_validate: {
            validation_result = validate_iso_schema(iso_xml),
            metadata_score = calculate_metadata_score(iso_xml)
        }
    },
    
    constraint MetadataCompleteness {
        iso_xml.fileIdentifier != null,
        iso_xml.contact.length > 0,
        metadata_score >= 0.7
    }
}

process MetadataQualityAssessment {
    inputs: {
        iso_metadata: ISO19115_Metadata
    },
    
    outputs: {
        overall_score: Real,  // 0-100
        component_scores: Map<String, Real>,
        recommendations: Array<String>
    },
    
    scoring_criteria: {
        // Identification completeness (30 points)
        identification_score: {
            title: 5 * points if exists,
            abstract: 10 * points if exists and length > 100,
            purpose: 5 * points if exists,
            keywords: 5 * points if count >= 5,
            topic_category: 5 * points if exists
        },
        
        // Responsible party info (20 points)
        contact_score: {
            creator: 7 * points if complete_contact_info,
            publisher: 7 * points if complete_contact_info,
            contributor: 6 * points if exists
        },
        
        // Spatial-temporal extent (25 points)
        extent_score: {
            geographic_extent: 10 * points if valid_bounding_box,
            temporal_extent: 10 * points if valid_time_range,
            vertical_extent: 5 * points if exists
        },
        
        // Data quality and lineage (15 points)
        quality_score: {
            lineage: 10 * points if exists and detailed,
            quality_measures: 5 * points if exists
        },
        
        // Distribution and access (10 points)
        distribution_score: {
            online_resource: 5 * points if exists,
            format: 3 * points if specified,
            transfer_options: 2 * points if exists
        }
    },
    
    method generate_recommendations(): Array<String> {
        if identification_score < 25 {
            recommendations.append(
                "Add more detailed abstract and keywords"
            )
        },
        if contact_score < 15 {
            recommendations.append(
                "Complete contact information with email and URL"
            )
        },
        return recommendations
    }
}

scenario USGSBarnegatBayMetadata {
    metadata: ISO19115_Metadata {
        fileIdentifier: "59f8af92e4b063d5d309f043",
        
        contact: [
            ResponsibleParty {
                individualName: "Zafer Defne",
                organisationName: "U.S. Geological Survey",
                contactInfo: ContactInfo {
                    electronicMailAddress: "zdefne@usgs.gov",
                    onlineResource: 
                        "https://www.usgs.gov/staff-profiles/zafer-defne"
                },
                role: "pointOfContact"
            }
        ],
        
        identificationInfo: DataIdentification {
            citation: Citation {
                title: "USGS Barnegat Bay Hydrodynamic Model 
                        for March-September 2012"
            },
            
            extent: Extent {
                geographicExtent: GeographicExtent {
                    westBoundLongitude: -74.3 with unit degree,
                    eastBoundLongitude: -74.0 with unit degree,
                    southBoundLatitude: 39.5 with unit degree,
                    northBoundLatitude: 40.0 with unit degree
                },
                
                temporalExtent: TemporalExtent {
                    beginPosition: DateTime("2012-03-01T00:00:00Z"),
                    endPosition: DateTime("2012-09-30T23:30:00Z")
                },
                
                verticalExtent: VerticalExtent {
                    minimumValue: -5.0 with unit meter,
                    maximumValue: 2.0 with unit meter
                }
            }
        }
    }
}

workflow OceanModelMetadataPublishing {
    inputs: {
        model_output_directory: String,
        ncml_template: String,
        xsl_stylesheet: String,
        thredds_catalog: String
    },
    
    pipeline: {
        stage1_aggregate: {
            netcdf_files = scan_directory(model_output_directory),
            ncml_aggregation = create_ncml_aggregation(
                files: netcdf_files,
                dimension: "ocean_time"
            )
        },
        
        stage2_enhance_acdd: {
            enhanced_attrs = enhance_acdd_attributes(
                ncml_aggregation,
                required_fields: ["title", "summary", "creator_name"]
            )
        },
        
        stage3_generate_iso: {
            iso_xml = NetCDF2ISOConversion.execute(
                netcdf_file: enhanced_attrs,
                xsl_stylesheet: xsl_stylesheet
            )
        },
        
        stage4_assess_quality: {
            quality = MetadataQualityAssessment.execute(iso_xml),
            if quality.overall_score < 70 {
                warning("Metadata quality below threshold")
            }
        },
        
        stage5_publish_thredds: {
            dataset_entry = create_thredds_dataset(
                metadata_url: iso_xml,
                services: ["OPeNDAP", "HTTPServer", "WMS"]
            ),
            updated_catalog = update_thredds_catalog(
                thredds_catalog, dataset_entry
            )
        },
        
        stage6_register: {
            sciencebase_item = register_to_sciencebase(iso_xml)
        }
    },
    
    dataflow: {
        model_output_directory -> stage1_aggregate -> ncml,
        ncml -> stage2_enhance_acdd -> enhanced,
        enhanced -> stage3_generate_iso -> iso_xml,
        iso_xml -> stage4_assess_quality -> quality_report,
        iso_xml -> stage5_publish_thredds -> catalog,
        iso_xml -> stage6_register -> sciencebase_id
    }
}
