// CZ-DSL - Southeast Asia mangroves coastal-zone scenario
// Generated by tools/regional/emit_cz.py from data/regional/derived/seasia.json.
// Every numeric value is read from that derived record, which is built only
// from files registered in data/regional/SOURCES.json. Do not edit by hand.
//
// Region: Southeast Asia
// Sources: 3 files, 471186157 bytes, 3 distinct providers.


// ====================================================================
// Spatial reference system
// The four states sit in different projected systems and different tidal
// regimes, and the mangrove product is a global vector set with no
// national datum at all. The case therefore keeps one geographic frame
// and records the national frames as related, not substituted.
// ====================================================================

spatial_reference_system SEAsia_SRM {
    geographic_crs: EPSG_4326,
    national_grids: [EPSG_32647, EPSG_32648, EPSG_5235, EPSG_32644],
    vertical_datum: national_tidal_datums_not_shared,
    water_level_datum: MSL_anomaly,
    tidal_regime: mixed_semidiurnal_to_diurnal,
    extent: 79.0, -11.0, 141.0, 24.0,
    cell_size: 25.0 * meter
}


// ====================================================================
// Scenario declaration
// ====================================================================

scenario SEAsia_MangroveTrajectory {
    description: "Forty years of mangrove extent across four states, with "
                 "the country trajectories kept separate because they do "
                 "not share a sign",
    spatial_ref: SEAsia_SRM,
    time_horizon: 1985-2025,
    reference_epoch: 2025,
    n_years: 41,
    regional_extent_1985: 4207515.6 * hectare,
    regional_extent_2025: 3980589.9 * hectare,
    polygon_count_2020: 1198516,
    country_trajectories: {
        THA: { name: "Thailand", extent_1985: 248245.1, extent_2020: 258339.5, extent_2025: 260828.4, net_change_pct: 5.07, peak_year: 2025 },
        LKA: { name: "Sri Lanka", extent_1985: 9636.6, extent_2020: 12061.7, extent_2025: 13483.5, net_change_pct: 39.92, peak_year: 2025 },
        IDN: { name: "Indonesia", extent_1985: 3350915.5, extent_2020: 3124109.4, extent_2025: 3146543.5, net_change_pct: -6.10, peak_year: 1996 },
        MYS: { name: "Malaysia", extent_1985: 598718.3, extent_2020: 563389.9, extent_2025: 559734.5, net_change_pct: -6.51, peak_year: 1996 },
    },
    note: "Indonesia and Thailand lose and gain respectively over the same "
          "window, so a single regional trend would be an artefact of "
          "aggregation",
    reef_polygons: 10769,
    reef_area_km2: 46868.4,
    reef_attribute_gap: 10769
}


coastal_database SEAsiaCZDB {
    id: "CZDB-SEA-001",
    version: "1.0.0",
    spatial: SEAsia_SRM,
    temporal: Scenario_1985_2025,
    tiling: CZDB_TileScheme_25m,
    cdb_profile: OGC_CDB_1_0,
    metadata: {
        title: "Southeast Asia mangrove coastal-zone database",
        region: "Thailand, Sri Lanka, Indonesia and Malaysia",
        source_files: 3,
        source_bytes: 471186157,
        providers: 3,
        countries: 4,
        years: 41
    },
    layers: {
        coral_reef: layer {
            type: BioticComponentLayer,
            datasets: {
                wcmc_reef_polygons: dataset {
                    feature_class: CoralReefExtent,
                    polygons: 10769,
                    area_km2: 46868.4,
                    taxonomy_available: false,
                    caveat: "the polygon is mapped reef extent, not live coral cover, so this area bounds the reef and not the coral",
                    cmecs_unit: CMECS_Biotic_Coral_Reef
                }
            }
        },
        mangrove_extent: layer {
            type: BioticComponentLayer,
            datasets: {
                gmw_timeseries: dataset {
                    feature_class: MangroveExtent,
                    spatial_resolution: 25.0 * meter,
                    temporal_resolution: 1.0 * year,
                    uncertainty_model: CategoricalConfusionMatrix,
                    confidence_interval: presented_as_lower95th_and_upper95th,
                    cmecs_unit: CMECS_Biotic_Mangrove
                },
                gmw_2020_vector: dataset {
                    feature_class: MangrovePolygon,
                    spatial_resolution: 10.0 * meter,
                    polygons: 1198516,
                    cmecs_unit: CMECS_Biotic_Mangrove
                }
            }
        }
    }
}


data_source WCMC_CoralReefs2018 {
    source_type: derived,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2018,
    temporal_resolution: single_epoch,
    format: ZIP,
    url: "data/regional/raw/coral_wcmc_2018/WCMC008_coral_reefs_2018_v4_1.zip",
    note: "reef polygons 10769 totalling 46868 km2 across the four states; the taxonomy fields are "Not Reported" throughout, so the layer is geometry without attributes",
    classification: CZ.BE.HABITAT.CORAL_REEF,
}


data_source WRI_ReefsAtRisk {
    source_type: derived,
    coordinate_ref: World_Cylindrical_Equal_Area,
    temporal_ref: 2011,
    temporal_resolution: single_epoch,
    format: ZIP,
    url: "data/regional/raw/coral_reefs_at_risk/WRI002_reefs_at_risk_2011.zip",
    note: "reef threat classes under a clean CC BY 3.0 licence, used where redistribution matters because the WCMC polygons do not permit it",
    classification: CZ.BE.PRESSURE.REEF_THREAT,
}


data_source GMW_CountryTimeseries {
    source_type: derived,
    coordinate_ref: EPSG_4326,
    temporal_ref: 1985-2025,
    temporal_resolution: annual,
    format: XLSX,
    url: "data/regional/raw/seasia_gmw_stats/gmw_v4112_country_stats.xlsx",
    note: "41 annual country totals; the product carries lower and upper 95% bounds as separate sheets, which is a quantified uncertainty that a single extent number would lose",
    classification: CZ.BE.HABITAT.MANGROVE,
}


data_source GMW_2020_Polygons {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2020,
    temporal_resolution: single_epoch,
    format: ZIP,
    url: "data/regional/raw/seasia_gmw_2020/gmw_mng_2020_vec.zip",
    note: "polygon count 1198516; sensor Sentinel-2",
    classification: CZ.BE.HABITAT.MANGROVE,
}


// ====================================================================
// Cross-subject links
// ====================================================================

cross_subject_link TimeseriesToVector {
    source: GMW_CountryTimeseries,
    target: GMW_2020_Polygons,
    link_type: consistency,
    relation_kind: r_S,
    spatial_predicate: contains,
    variables: [mangrove_extent],
    note: {
        expected: "the 2020 polygon set should sum to the 2020 country total",
        status: "checked per country, and the national frames differ, so the "
                "comparison is reported rather than enforced"
    }
}

cross_subject_link NationalFrames {
    source: GMW_2020_Polygons,
    target: SEAsia_SRM,
    link_type: constraint,
    relation_kind: r_F,
    function: national_grid = f(geographic_position, national_datum),
    variables: [coordinate_ref],
    coupling_interval: static,
}

granularity SEAsiaGranularity {
    level: L2,
    spatial: 90.0 * meter,
    temporal: 1.0 * year,
    note: "country totals are WholeDomain; the polygons are CorePatch"
}

classification_layer SEAsiaClassification {
    scheme: CMECS,
    vocabulary: [CMECS_Biotic_Mangrove],
    crosswalk: "GMW does not use CMECS units; the code namespace carries the "
               "mangrove class while the GMW unit system is preserved as a "
               "separate partial facet"
}
