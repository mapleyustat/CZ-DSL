// CZ-DSL - Yangtze Delta coastal-zone scenario
// Generated by tools/regional/emit_cz.py from data/regional/derived/yangtze.json.
// Every numeric value is read from that derived record, which is built only
// from files registered in data/regional/SOURCES.json. Do not edit by hand.
//
// Region: Yangtze Delta / China
// Sources: 4 files, 31916499 bytes, 4 distinct providers.


// ====================================================================
// Spatial reference system
// The delta is the case where the vertical datum is moving: the land is
// subsiding faster than the ocean is rising, so the same gauge record is
// half sea level and half ground motion. The land and marine frames are
// both present and are related through an explicit velocity field.
// ====================================================================

spatial_reference_system Yangtze_SRM {
    geographic_crs: EPSG_4326,
    land_vertical_datum: 1985_National_Height_Datum,
    marine_vertical_datum: Wusong_Chart_Datum,
    water_level_datum: MSL_anomaly,
    vertical_rate_datum: global_VLM_synthesis,
    extent: 119.0, 28.0, 123.0, 34.0,
    cell_size: 30.0 * meter
}


scenario Yangtze_ErosionSubsidence {
    description: "Thirty-seven years of surface-water change at the delta "
                 "mouth, read against a gauge record whose trend is dominated "
                 "by subsidence rather than by the ocean",
    spatial_ref: Yangtze_SRM,
    time_horizon: 1961-2021,
    reference_epoch: 2020,
    surface_water_span: "1984-2021",
    observed_trend: 5.317 * mm/year,
    observed_trend_r: 0.523,
    hourly_max: 4.57 * meter,
    hourly_std: 1.391 * meter,
    hourly_rows: 187201,
    permanent_water_cells: 1199495572,
    new_permanent_cells: 2062320,
    lost_permanent_cells: 3446841,
    note: "a gauge trend of this size cannot be read as sea level until the "
          "land motion is subtracted"
}


coastal_database YangtzeCZDB {
    id: "CZDB-YZ-001",
    version: "1.0.0",
    spatial: Yangtze_SRM,
    temporal: Scenario_1961_2021,
    tiling: CZDB_TileScheme_30m,
    cdb_profile: OGC_CDB_1_0,
    metadata: {
        title: "Yangtze Delta coastal-zone database",
        region: "Yangtze Delta and Shanghai, China",
        source_files: 4,
        source_bytes: 31916499,
        providers: 4
    },
    layers: {
        surface_water: layer {
            type: ProcessLayer,
            datasets: {
                gsw_transitions: dataset {
                    feature_class: WaterTransitionClass,
                    spatial_resolution: 27.8 * meter,
                    temporal_resolution: 1.0 * year,
                    year_span: "1984-2021",
                    classes: {
            "no change (never water in either epoch)": 377280815,
            "permanent": 1199495572,
            "new permanent": 2062320,
            "lost permanent": 3446841,
            "seasonal": 2497166,
            "new seasonal": 5536528,
            "lost seasonal": 2129053,
            "seasonal to permanent": 828317,
            "permanent to seasonal": 1878455,
            "ephemeral permanent": 809040,
            "ephemeral seasonal": 4035893,
                    },
                    cmecs_unit: CMECS_Water_Column_Surface_Water
                }
            }
        },
        vertical_motion: layer {
            type: AttributeLayer,
            datasets: {
                global_vlm: dataset {
                    feature_class: VerticalVelocityField,
                    unit: mm/year,
                    global_range: [-35.64, 17.39],
                    cmecs_unit: CMECS_Process_Subsidence
                }
            }
        }
    }
}


data_source JRC_GSW_Transitions {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 1984-2021,
    temporal_resolution: annual,
    format: TIF,
    url: "data/regional/raw/yz_gsw_transitions/gsw_transitions_120E_40N.tif",
    note: "1600000000 cells at 27.8 m; the tile is named by its north-west corner, so 120E_40N is the one that contains Shanghai",
    classification: CZ.CC.EROSION.SURFACE_WATER,
}


data_source PSMSL_Lusi {
    source_type: observation,
    coordinate_ref: Wusong_station_datum,
    temporal_ref: 1961-2020,
    temporal_resolution: monthly,
    format: RLRDATA,
    url: "data/regional/raw/yz_psmsl_lusi/psmsl_lusi_979_monthly.rlrdata",
    note: "602 monthly means, trend 5.32 mm/year",
    classification: CZ.CC.SEALEVEL.GAUGE,
}


data_source UHSLC_Lusi_Hourly {
    source_type: observation,
    coordinate_ref: Wusong_station_datum,
    temporal_ref: 1975-1996,
    temporal_resolution: hourly,
    format: CSV,
    url: "data/regional/raw/yz_uhslc_lusi/uhslc_lusi_hourly.csv",
    note: "187201 hourly values; the series stops in 1996, so it cannot be joined to the recent surface-water record without a gap",
    classification: CZ.CC.SEALEVEL.HOURLY,
}


data_source Global_VLM {
    source_type: derived,
    coordinate_ref: EPSG_4326,
    temporal_ref: 1995-2020,
    temporal_resolution: decadal_mean,
    format: NC,
    url: "data/regional/raw/yz_vlm/global_vlm_oelsmann_2025.nc",
    note: "InSAR and GNSS synthesis; the file is a global grid so the delta is a window rather than a dedicated product",
    classification: CZ.WD.SUBSIDENCE.VELOCITY,
}


// ====================================================================
// Cross-subject links
// ====================================================================

cross_subject_link GaugeToVerticalMotion {
    source: PSMSL_Lusi,
    target: Global_VLM,
    link_type: constraint,
    relation_kind: r_F,
    function: absolute_sea_level = relative_sea_level + vertical_land_motion,
    variables: [relative_sea_level_trend, vertical_velocity],
    coupling_interval: decadal,
    note: "the whole scientific reading of this case rests on this one "
          "functional relation; without it the gauge trend is misread"
}

cross_subject_link WaterChangeToSubsidence {
    source: JRC_GSW_Transitions,
    target: Global_VLM,
    link_type: comparison,
    relation_kind: r_C,
    variables: [lost_permanent_cells, vertical_velocity],
    sample_size: 1600000000,
    note: "a correlation is declared as a correlation; the case does not "
          "claim the water change is caused by subsidence"
}

cross_subject_link HourlyToMonthly {
    source: UHSLC_Lusi_Hourly,
    target: PSMSL_Lusi,
    link_type: aggregation,
    relation_kind: r_T,
    temporal_lag: 0.0 * year,
    variables: [sea_level],
    coupling_interval: monthly,
    note: "hourly to monthly is an aggregation with a support change, not a "
          "resampling; the extremes do not survive it and are kept separately"
}

granularity YangtzeGranularity {
    level: L3,
    spatial: 30.0 * meter,
    temporal: 1.0 * hour,
    note: "the surface-water record is annual, the gauge hourly but ending "
          "in 1996, and the VLM field decadal; the declared level is finer "
          "than any single member"
}

classification_layer YangtzeClassification {
    scheme: CMECS,
    vocabulary: [CMECS_Water_Column_Surface_Water, CMECS_Process_Subsidence],
    crosswalk: "the Chinese national marine functional zoning classes have "
               "no CMECS mapping and are carried unmapped"
}
