// CZ-DSL - Baltic Sea coastal-zone scenario
// Generated by tools/regional/emit_cz.py from data/regional/derived/baltic.json.
// Every numeric value is read from that derived record, which is built only
// from files registered in data/regional/SOURCES.json. Do not edit by hand.
//
// Region: Baltic Sea
// Sources: 28 files, 320839298 bytes, 5 distinct providers.


// ====================================================================
// Spatial reference system
// The Baltic is the case where the two vertical references move relative
// to one another in a way that has a sign: the land is still rebounding
// from the last glaciation faster than the sea is rising, so the same
// "sea level" element is negative over the Swedish coast and positive in
// the south. A description that stores one number for "sea level" is
// therefore wrong on one side or the other.
// ====================================================================

spatial_reference_system Baltic_SRM {
    geographic_crs: EPSG_4326,
    land_vertical_datum: RH2000_land_uplift,
    marine_vertical_datum: Baltic_Sea_Chart_Datum,
    water_level_datum: MSL_anomaly,
    vertical_rate_datum: NKG2016LU_vertical_velocity,
    datum_relation: "RH2000 and BSCD differ by a time-varying offset that is "
                    "not a constant; the land-to-sea join must carry the epoch",
    extent: 10.0, 54.0, 22.0, 66.0,
    cell_size: 1000.0 * meter,
    comment: "land heights on RH2000, marine depths on BSCD, both referred "
             "to NKG2016LU so the uplift can be applied consistently"
}


// ====================================================================
// Scenario declaration
// ====================================================================

scenario BalticSea_EutrophicationHypoxia {
    description: "Sixty years of measured hypoxia against a modelled "
                 "reanalysis of the same basin, plus the shipping pressure "
                 "and the sea-level signal that is actually land motion",
    spatial_ref: Baltic_SRM,
    time_horizon: 1960-2025,
    reference_epoch: 2019,
    observation_span: 1960-2019,
    observation_count: 152799,
    station_count: 2562,
    hypoxia_threshold: 2.0 * ml/l,
    deep_water_mean_oxygen: 0.237 * ml/l,
    deep_water_hypoxic_fraction: 0.9806,
    surface_oxygen_trend: 0.6532 * ml/l/year_decade,
    surface_oxygen_trend_r: 0.579,
    relative_sea_level_trend: -3.653 * mm/year,
    relative_sea_level_trend_r: -0.927,
    land_uplift_sign: "negative relative sea level at Stockholm is rebound, not a falling sea"
}


// ====================================================================
// Coastal database - the layer inventory, one entry per retrieved source
// ====================================================================

coastal_database BalticSeaCZDB {
    id: "CZDB-BAL-001",
    version: "1.0.0",
    spatial: Baltic_SRM,
    temporal: Scenario_1960_2025,
    tiling: CZDB_TileScheme_1000m,
    cdb_profile: OGC_CDB_1_0,

    metadata: {
        title: "Baltic Sea coastal-zone database",
        region: "Baltic Sea, Gotland Basin and Swedish coast",
        provider: "Coastal Systems Lab",
        source_files: 28,
        source_bytes: 320839298,
        providers: 5,
        observations: 152799,
        model_profiles: 4
    },

    layers: {
        oxygen_observation: layer {
            type: AttributeLayer,
            datasets: {
                bed_gotland_oxygen: dataset {
                    feature_class: WaterQualityStation,
                    parameter: dissolved_oxygen,
                    unit: ml/l,
                    sample_depth_max: 250.0 * meter,
                    station_count: 2562,
                    temporal_resolution: irregular_station_occupation,
                    quality_profile: BED_QC_flag_per_variable,
                    cmecs_unit: CMECS_Water_Column_Deep
                }
            }
        },
        oxygen_model: layer {
            type: ModelFieldLayer,
            datasets: {
                ergom_oxygen: dataset {
                    feature_class: GriddedWaterColumn,
                    parameter: dissolved_oxygen,
                    unit: mmol/m3,
                    grid_levels: 35,
                    temporal_resolution: 1.0 * month,
                    quality_profile: Reanalysis_NoAssimilation_QC2,
                    cmecs_unit: CMECS_Water_Column_Deep
                }
            }
        },
        vessel_pressure: layer {
            type: PressureLayer,
            datasets: {
                emodnet_vessel_density: dataset {
                    feature_class: VesselDensityRaster,
                    unit: ships_per_cell_year,
                    spatial_resolution: 1000.0 * meter,
                    mean_density: 0.0000,
                    p95_density: 0.0000,
                    occupied_fraction: 0.0005,
                    cmecs_unit: CMECS_Anthropogenic_Pressure
                }
            }
        },
        bathymetry: layer {
            type: BathymetryLayer,
            datasets: {
                emodnet_dtm: dataset {
                    feature_class: GriddedElevation,
                    spatial_resolution: 0.01 * degree,
                    depth_min: -730.3 * meter,
                    depth_max: 1665.0 * meter,
                    note: "the EMODnet DTM is not bathymetry alone; it also "
                          "carries land elevation, so this single layer "
                          "already crosses the land-sea boundary",
                    cmecs_unit: CMECS_Substrate_Bathymetry
                }
            }
        }
    }
}


data_source BED_Gotland_Oxygen {
    source_type: observation,
    coordinate_ref: WGS84_station_position,
    temporal_ref: 1960-2019,
    temporal_resolution: irregular,
    format: CSV,
    url: "data/regional/raw/baltic_bed_gotland_*/bed_gotland_*.csv",
    note: "oxygen samples 152799; stations 2562; 1960-2019, to 250 m",
    classification: CZ.WD.WATERCOLUMN.OXYGEN,
}


data_source Copernicus_ERGOM_Oxygen {
    source_type: simulation,
    coordinate_ref: EPSG_4326,
    temporal_ref: 1993-2023, August,
    temporal_resolution: monthly,
    format: NC,
    url: "data/regional/raw/baltic_bgc_*/baltic_bgc_ERGOM_*.nc",
    note: "ERGOM reanalysis; the grid fills below-seafloor cells with -999.0, which is 91% of the cells, so the fill must be masked before any aggregate",
    classification: CZ.WD.WATERCOLUMN.OXYGEN,
}


data_source PSMSL_Stockholm_Annual {
    source_type: observation,
    coordinate_ref: RH2000_station_datum,
    temporal_ref: 1889-2024,
    temporal_resolution: annual,
    format: RLRDATA,
    url: "data/regional/raw/baltic_psmsl_stockholm/psmsl_stockholm_78_annual.rlrdata",
    note: "Stockholm id 78, 136 annual means, trend -3.65 mm/year",
    classification: CZ.CC.SEALEVEL.GAUGE,
}


data_source EMODnet_VesselDensity {
    source_type: derived,
    coordinate_ref: EPSG_3857,
    temporal_ref: 2024,
    temporal_resolution: annual_mean,
    format: TIF,
    url: "data/regional/raw/baltic_vessel_density/emodnet_vesseldensity_baltic_2024.tif",
    note: "AIS-derived annual mean; the raster is Web Mercator while the imagery in this case is EPSG:4326, an explicit horizontal-datum mismatch",
    classification: CZ.BE.PRESSURE.SHIPPING,
}


data_source EMODnet_Bathymetry {
    source_type: derived,
    coordinate_ref: EPSG_4326,
    temporal_ref: static,
    temporal_resolution: static,
    format: TIF,
    url: "data/regional/raw/baltic_bathy_*/emodnet_bathy_*.tif",
    note: "16 tiles of 3 degrees mosaicked into 1200x1200",
    classification: CZ.CP.BATHYMETRY.GRID,
}


// ====================================================================
// Model adapters
// ====================================================================

model_adapter ERGOM_Biogeochemistry {
    model_type: biogeochemical,
    engine: ERGOM,
    inputs: [nutrient_load, temperature, light, bathymetry],
    outputs: [o2, no3, po4, nh4, chl, ph],
    parameters: {
        wet_levels: 35,
        fill_value: -999.0,
        surface_o2_1993: 6.993 * ml/l,
        bottom_o2_1993: 3.155 * ml/l,
        bottom_o2_2023: 2.552 * ml/l,
        top_hypoxic_1993: 148.9 * meter,
        top_hypoxic_2023: 103.8 * meter
    },
    classification: CZ.WD.WATERCOLUMN.BGC_MODEL,
}

model_adapter HypoxiaBoundaryEstimator {
    model_type: statistical,
    engine: BinnedProfileThreshold,
    inputs: [oxygen_profile],
    outputs: [top_hypoxic_depth, surface_oxygen, mid_depth_oxygen],
    parameters: {
        bin_size: 10.0 * meter,
        min_samples_per_bin: 8,
        threshold: 2.0 * ml/l,
        surface_trend: 0.653 * ml/l/decade,
        surface_trend_r: 0.579,
        years: 60
    },
    classification: CZ.WD.WATERCOLUMN.HYPOXIA_INDEX,
}


// ====================================================================
// Cross-subject links - the observation-model duality, and the couplings
// that carry it
// ====================================================================

cross_subject_link OxygenObservationToModel {
    source: BED_Gotland_Oxygen,
    target: ERGOM_Biogeochemistry,
    link_type: comparison,
    relation_kind: r_S,
    spatial_predicate: within_same_1_degree_box,
    variables: [o2],
    agreement: "the two disagree on where hypoxia begins: the observations "
               "place the boundary near 80 m, "
               "the model between 104 and 149 m",
    note: "declared as a comparison rather than an assimilation, because "
          "the model is a reanalysis that does not ingest these casts"
}

cross_subject_link VesselPressureToHypoxia {
    source: EMODnet_VesselDensity,
    target: HypoxiaBoundaryEstimator,
    link_type: constraint,
    relation_kind: r_S,
    spatial_predicate: intersects,
    variables: [vessel_density],
    coupling_interval: annual,
    note: "shipping pressure is a candidate driver, not a demonstrated cause"
}

cross_subject_link UpliftToSeaLevel {
    source: PSMSL_Stockholm_Annual,
    target: ERGOM_Biogeochemistry,
    link_type: constraint,
    relation_kind: r_F,
    function: relative_sea_level = absolute_sea_level - vertical_land_motion,
    variables: [relative_sea_level_trend],
    coupling_interval: decadal,
    note: "the sign of the Stockholm trend is set by the uplift term, so the "
          "two cannot be described independently"
}

cross_subject_link BathyToOxygenField {
    source: EMODnet_Bathymetry,
    target: ERGOM_Biogeochemistry,
    link_type: data_flow,
    relation_kind: r_S,
    spatial_predicate: covers,
    variables: [depth],
    coupling_interval: static,
}


// ====================================================================
// Granularity and classification layers
// ====================================================================

granularity BalticGranularity {
    level: L0,
    spatial: 1000.0 * meter,
    temporal: 1.0 * year,
    note: "the Gotland box is described at whole-domain resolution; the "
          "station casts are BaseElement and keep their own coordinates"
}

classification_layer BalticClassification {
    scheme: CMECS,
    vocabulary: [CMECS_Water_Column_Deep, CMECS_Substrate_Bathymetry,
                 CMECS_Anthropogenic_Pressure],
    crosswalk: "no crosswalk exists from the CMECS scheme to the HELCOM oxygen "
               "assessment classes; both are carried and neither is mapped"
}
