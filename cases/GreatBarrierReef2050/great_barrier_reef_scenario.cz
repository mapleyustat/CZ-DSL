// CZ-DSL - Great Barrier Reef coastal-zone scenario
// Generated by tools/regional/emit_cz.py from data/regional/derived/australia.json.
// Every numeric value is read from that derived record, which is built only
// from files registered in data/regional/SOURCES.json. Do not edit by hand.
//
// Region: Australia / Great Barrier Reef
// Sources: 9 files, 266404652 bytes, 4 distinct providers.


// ====================================================================
// Spatial reference system
// The reef is mapped in GDA2020 on land and in a marine park grid at sea,
// and the cyclone archive is a point track with a wind radius rather than
// a field. Three geometry types meet on one feature.
// ====================================================================

spatial_reference_system GBR_SRM {
    geographic_crs: EPSG_4326,
    land_vertical_datum: AHD,
    marine_vertical_datum: LAT,
    horizontal_land_grid: GDA2020_MGA_zone_55,
    horizontal_marine_grid: GBRMPA_marine_grid,
    water_level_datum: MSL_anomaly,
    extent: 142.0, -25.0, 155.0, -9.0,
    cell_size: 1000.0 * meter
}


scenario GBR_CycloneCoralStress {
    description: "Cyclone exposure of the Great Barrier Reef set against the "
                 "sea-level record, with the track archive kept as measured "
                 "rather than interpolated onto a grid",
    spatial_ref: GBR_SRM,
    time_horizon: 1886-2026,
    reference_epoch: 2026,
    track_points: 77168,
    storms: 1257,
    storms_over_reef: 503,
    points_over_reef: 15359,
    max_wind: 150.0 * knot,
    min_pressure: 884.0 * hPa,
    strongest_over_reef: 120.0 * knot,
    sea_level_trend: 0.593 * mm/year,
    sea_level_span: "1886-1993",
    reef_polygons: 1686,
    reef_area_km2: 39007.5,
    reef_attribute_records: 1686,
    bleaching_years: 6,
    bleaching_max_dhw_first: 11.72,
    bleaching_max_dhw_last: 14.90,
    bleaching_frac_ge4_first: 0.5528,
    bleaching_frac_ge4_last: 0.9340
}


coastal_database GBRCZDB {
    id: "CZDB-GBR-001",
    version: "1.0.0",
    spatial: GBR_SRM,
    temporal: Scenario_1886_2026,
    tiling: CZDB_TileScheme_1000m,
    cdb_profile: OGC_CDB_1_0,
    metadata: {
        title: "Great Barrier Reef cyclone and sea-level database",
        region: "Great Barrier Reef, Australia",
        source_files: 9,
        source_bytes: 266404652,
        providers: 4,
        storms: 1257
    },
    layers: {
        cyclone_track: layer {
            type: ProcessLayer,
            datasets: {
                ibtracs_sp: dataset {
                    feature_class: TropicalCycloneTrack,
                    geometry_type: MultiLineStringWithWindRadii,
                    temporal_resolution: 6.0 * hour,
                    quality_profile: IBTrACS_WMO_agency_blend,
                    cmecs_unit: CMECS_Process_Storm
                }
            }
        },
        bleaching_stress: layer {
            type: ProcessLayer,
            datasets: {
                crw_dhw: dataset {
                    feature_class: ThermalStressField,
                    unit: degree_heating_week,
                    spatial_resolution: 5000.0 * meter,
                    fill_value: -327.68,
                    fill_note: "this product uses -327.68 where the ERGOM product in the Baltic case uses -999.0; the fill is read from the file attribute so the two are never confused",
                    bleaching_threshold: 4.0 * degree_heating_week,
                    severe_threshold: 8.0 * degree_heating_week,
                    march_declared: {
                2002: { max: 11.72, mean: 5.02, ge4: 0.5528, ge8: 0.2265 },
                2016: { max: 12.23, mean: 5.54, ge4: 0.6718, ge8: 0.1734 },
                2017: { max: 12.79, mean: 5.48, ge4: 0.7508, ge8: 0.1065 },
                2020: { max: 14.61, mean: 8.19, ge4: 0.9452, ge8: 0.5622 },
                2022: { max: 15.57, mean: 5.62, ge4: 0.8397, ge8: 0.0703 },
                2024: { max: 14.90, mean: 8.29, ge4: 0.9340, ge8: 0.5812 },
                    },
                    cmecs_unit: CMECS_Process_Thermal_Stress
                }
            }
        },
        coral_reef: layer {
            type: BioticComponentLayer,
            datasets: {
                wcmc_reef_polygons: dataset {
                    feature_class: CoralReefExtent,
                    spatial_resolution: 30.0 * meter,
                    polygons: 1686,
                    area_km2: 39007.5,
                    taxonomy_available: false,
                    attribute_gap: 1686,
                    caveat: "the polygon is mapped reef extent, not live coral cover, so this area bounds the reef and not the coral",
                    cmecs_unit: CMECS_Biotic_Coral_Reef
                }
            }
        },
        sea_level: layer {
            type: WaterLevelLayer,
            datasets: {
                fort_denison: dataset {
                    feature_class: TideGaugeStation,
                    temporal_resolution: 1.0 * year,
                    years: 108,
                    trend: 0.593 * mm/year,
                    cmecs_unit: CMECS_Water_Column_Water_Level
                }
            }
        }
    }
}


data_source WCMC_CoralReefs2018 {
    source_type: derived,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2018,
    temporal_resolution: single_epoch,
    format: ZIP,
    url: "data/regional/raw/coral_wcmc_2018/WCMC008_coral_reefs_2018_v4_1.zip",
    note: "reef polygons 1686 over the Great Barrier Reef, 39007 km2; the taxonomy fields read "Not Reported" for every polygon and the companion point layer stops at the Caribbean, so this layer is geometry without attributes -- an attribute gap the description records rather than fills",
    classification: CZ.BE.HABITAT.CORAL_REEF,
}


data_source CRW_DHW_March {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2002-2024, March,
    temporal_resolution: daily,
    format: NC,
    url: "data/regional/raw/aus_crw_dhw_200203/crw_dhw_200203_gbr.nc",
    note: "degree heating weeks, 6 Marches, fill -327.68; the whole-basin multi-year request times out through this network so the series is assembled from small monthly slices",
    classification: CZ.BE.HABITAT.THERMAL_STRESS,
}


data_source IBTrACS_SouthPacific {
    source_type: observation,
    coordinate_ref: WGS84_geodetic,
    temporal_ref: 1897-2026,
    temporal_resolution: 6_hourly,
    format: CSV,
    url: "data/regional/raw/aus_ibtracs_sp/ibtracs_SP_v04r01.csv",
    note: "1257 storms, 77168 fixes; the archive mixes agencies with different wind averaging periods, which is a real heterogeneity the language records per fix",
    classification: CZ.CC.HAZARD.CYCLONE,
}


data_source PSMSL_FortDenison {
    source_type: observation,
    coordinate_ref: AHD_station_datum,
    temporal_ref: 1886-1993,
    temporal_resolution: annual,
    format: RLRDATA,
    url: "data/regional/raw/aus_psmsl_sydney/psmsl_fort_denison_65_annual.rlrdata",
    note: "108 annual means, trend 0.59 mm/year",
    classification: CZ.CC.SEALEVEL.GAUGE,
}


// ====================================================================
// Cross-subject links
// ====================================================================

cross_subject_link TrackToReef {
    source: IBTrACS_SouthPacific,
    target: GBR_SRM,
    link_type: constraint,
    relation_kind: r_S,
    spatial_predicate: intersects,
    variables: [track_lat, track_lon, wind_radius],
    coupling_interval: per_event,
    note: "a track is not a field; the exposure of a reef cell is an "
          "intersection of a moving circle with a static geometry, and the "
          "temporal reference has to travel with it"
}

model_adapter BleachingStressTrend {
    model_type: statistical,
    engine: LinearTrendOnMarchStatistics,
    inputs: [crw_dhw],
    outputs: [max_dhw, mean_dhw, fraction_ge_4, fraction_ge_8],
    parameters: {
        years: 6,
        window: "March, central Great Barrier Reef",
        n_wet_cells: 142104,
        frac_ge_4_trend: 0.0175 * per_year,
        frac_ge_4_r: 0.890,
        max_dhw_trend: 0.1670 * per_year,
        max_dhw_r: 0.825
    },
    classification: CZ.BE.HABITAT.THERMAL_STRESS,
}

cross_subject_link BleachingToReef {
    source: WCMC_CoralReefs2018,
    target: IBTrACS_SouthPacific,
    link_type: constraint,
    relation_kind: r_S,
    spatial_predicate: intersects,
    variables: [reef_polygon, cyclone_track],
    coupling_interval: per_event,
    note: "the reef layer supplies geometry and no taxonomy; an exposure "
          "statement can therefore be made about reef *area* and not about "
          "any particular taxon, and the description says so"
}

cross_subject_link BleachingStressToReef {
    source: CRW_DHW_March,
    target: WCMC_CoralReefs2018,
    link_type: constraint,
    relation_kind: r_S,
    spatial_predicate: intersects,
    variables: [crw_dhw, reef_polygon],
    coupling_interval: annual,
    note: "thermal stress is a field and the reef is a polygon set; joining "
          "them requires a support change from a 5 km raster onto irregular "
          "polygons, which the description makes explicit rather than hides"
}

cross_subject_link CycloneToBleaching {
    source: IBTrACS_SouthPacific,
    target: BleachingStressTrend,
    link_type: comparison,
    relation_kind: r_C,
    variables: [max_wind, max_dhw],
    coupling_interval: annual,
    note: "cyclones cool the surface and bleaching heats it, so the two "
          "pressures can oppose one another in the same season; this is "
          "declared a correlation because the case does not separate them"
}

cross_subject_link SeaLevelToCoral {
    source: PSMSL_FortDenison,
    target: IBTrACS_SouthPacific,
    link_type: comparison,
    relation_kind: r_T,
    temporal_lag: 0.0 * year,
    variables: [relative_sea_level, storm_frequency],
    coupling_interval: annual,
}

granularity GBRGranularity {
    level: L3,
    spatial: 30.0 * meter,
    temporal: 1.0 * hour,
    note: "cyclone fixes are 6-hourly at best, so the declared finest "
          "temporal level is finer than the data can support and is used "
          "only by the storm-surge fields"
}

classification_layer GBRClassification {
    scheme: CMECS,
    vocabulary: [CMECS_Process_Storm, CMECS_Water_Column_Water_Level],
    crosswalk: "GBRMPA zoning classes have no CMECS equivalent and are "
               "carried as a second, unmapped facet"
}
