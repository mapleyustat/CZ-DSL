    format: Shapefile,
    url: "data/webdata/raw/planning/World_EEZ_v12_LR.zip",
    classification: CZ.CC.JURISDICTION.EEZ,
}
data_source Wave_Series_LongIsland {
    source_type: observation,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2024,
    resolution: 1.0 * hour,
    format: JSON,
