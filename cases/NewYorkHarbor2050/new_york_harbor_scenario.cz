    format: JPEG,
    url: "data/webdata/raw/imagery/gibs/",
    classification: CZ.CP.IMAGERY.OPTICAL,
}

// ====================================================================
// Model adapters - 8 models
// ====================================================================

model_adapter ROMS_NYOFS_Hydro {
    model_type: hydrodynamics,
    engine: ROMS,
    inputs: [bathymetry, tide_forcing, wind_field],
    outputs: [zeta, u, v],
    parameters: {
        sigma_layers: 4,
        wet_cells: 2840,
        max_current: 1.679 * m/s,
        max_wind: 9.98 * m/s,
    },
    classification: CZ.CP.HYDRODYNAMICS.ROMS,
}
model_adapter Gumbel_ExtremeValue {
    model_type: statistical,
    engine: Gumbel_MoM,
    inputs: [annual_max_water_level],
    outputs: [return_level_100yr, return_level_500yr],
    parameters: {
        n_years: 45,
        loc: 1.4682,
        scale: 0.2457,
        rp100: 2.599 * meter,
    },
    classification: CZ.CP.EXTREMES.GUMBEL,
}
model_adapter ConnectivityFlood {
    model_type: hydraulic,
    engine: PriorityFlood_BFS,
    inputs: [dem, water_level],
    outputs: [inundation_depth, inundation_extent],
    parameters: {
        connectivity: 4,
        rp100_area: 129.4 * km^2,
        rp100_population: 102196,
    },
    classification: CZ.CP.INUNDATION.CONNECTIVITY,
}
model_adapter HabitatExposure {
    model_type: ecological,
    engine: AreaWeightedOverlay,
    inputs: [inundation_extent, tidal_flat_fraction],
    outputs: [habitat_exposed],
    parameters: {
        habitat_total: 104.7 * km^2,
        rp100_exposed: 18.26 * km^2,
        rp100_pct: 17.44 * percent,
    },
    classification: CZ.WD.TIDALFLAT.EXPOSURE,
}
model_adapter PopulationExposure {
    model_type: economic,
    engine: SumPreservingOverlay,
    inputs: [inundation_extent, ghsl_population],
    outputs: [population_exposed],
    parameters: {
        domain_population: 10801986,
        rp100_exposed: 102196,
        rp100_pct: 0.946 * percent,
    },
    classification: CZ.CC.EXPOSURE.POPULATION,
}
model_adapter SeaLevelProjection {
    model_type: statistical,
    engine: LinearTrendExtrapolation,
    inputs: [psmsl_annual_mean, coops_mhhw],
    outputs: [slr_2050, slr_2100],
    parameters: {
        trend_central: 5.28 * mm/year,
        slr_2050: 0.1320 * meter,
        slr_2100: 0.3961 * meter,
    },
    classification: CZ.CP.WATERLEVEL.PROJECTION,
}
model_adapter SHAPEDTWValidation {
    model_type: statistical,
    engine: GaugeModelComparison,
    inputs: [coops_hourly, nyofs_zeta],
    outputs: [model_bias, model_rmse],
    parameters: {
        comparison: Battery_hourly_vs_NYOFS,
    },
    classification: CZ.CP.VALIDATION.GAUGE,
}
model_adapter WaveWindForcing {
    model_type: hydrodynamics,
    engine: BoundaryForcing,
    inputs: [wave_series, wind_series],
    outputs: [wave_setup, wind_setup],
    parameters: {
        wave_vars: hs, tp, dir,
        wind_vars: speed, direction,
    },
    classification: CZ.CP.FORCING.WAVEWIND,
}

// ====================================================================
// Cross-subject links - coupling graph
// ====================================================================

cross_subject_link ROMStoFlood {
    source: ROMS_NYOFS_Hydro,
    target: ConnectivityFlood,
    link_type: data_flow,
    variables: [zeta],
    coupling_interval: 1.0 * hour,
}
cross_subject_link SLRtoFlood {
    source: SeaLevelProjection,
    target: ConnectivityFlood,
    link_type: constraint,
    variables: [slr_2050, slr_2100],
    coupling_interval: per_scenario,
}
cross_subject_link GumbelToFlood {
    source: Gumbel_ExtremeValue,
    target: ConnectivityFlood,
    link_type: constraint,
    variables: [return_level_100yr],
    coupling_interval: climatology,
}
cross_subject_link WaveWindToFlood {
    source: WaveWindForcing,
    target: ConnectivityFlood,
    link_type: feedback,
    variables: [wind_setup],
    coupling_interval: 1.0 * hour,
}
cross_subject_link FloodToHabitat {
    source: ConnectivityFlood,
    target: HabitatExposure,
    link_type: data_flow,
    variables: [inundation_extent],
    coupling_interval: per_event,
}
cross_subject_link FloodToPopulation {
    source: ConnectivityFlood,
    target: PopulationExposure,
    link_type: data_flow,
    variables: [inundation_extent],
    coupling_interval: per_event,
}
cross_subject_link HabitatToPopulation {
    source: HabitatExposure,
    target: PopulationExposure,
    link_type: constraint,
    variables: [habitat_exposed],
    coupling_interval: per_scenario,
}
cross_subject_link GaugeToValidation {
    source: SHAPEDTWValidation,
    target: ROMS_NYOFS_Hydro,
    link_type: feedback,
    variables: [model_bias],
    coupling_interval: 1.0 * hour,
}

// ====================================================================
// Granularity - L0 to L3
// ====================================================================

granularity L0_WholeDomain {
    spatial: 1000.0 * meter,
    temporal: 1.0 * year,
    level: regional,
    lod: 0,
}
granularity L1_CoastalCell {
    spatial: 270.0 * meter,
    temporal: 1.0 * month,
    level: local,
    lod: 1,
}
granularity L2_CorePatch {
    spatial: 90.0 * meter,
    temporal: 1.0 * day,
    level: micro,
    lod: 2,
}
granularity L3_BaseElement {
    spatial: 30.0 * meter,
    temporal: 1.0 * hour,
    level: micro,
    lod: 3,
}

// ====================================================================
// Classification layers
// ====================================================================

classification_layer CMECS_NYHarbor {
    standard: CMECS,
    description: "CMECS units for New York Harbor tidal-flat and estuarine systems",
    codes: [
        CZ.WD.TIDALFLAT.GEOMORPHOLOGY,
        CZ.WD.ESTUARINE.SUBSYSTEM,
        CZ.WD.MARINE.SUBSYSTEM,
        CZ.CC.SETTLEMENT.RESIDENTIAL,
    ],
}
classification_layer EDCS_PhysicalCodes {
    standard: EDCS,
    description: "Environmental Data Coding Specification codes for physical layers",
    codes: [
        CZ.CP.BATHYMETRY.GRID,
        CZ.CP.HYDRODYNAMICS.ROMS,
        CZ.CP.INUNDATION.CONNECTIVITY,
        CZ.CP.WATERLEVEL.GAUGE,
        CZ.CP.EXTREMES.GUMBEL,
    ],
}

// ====================================================================
// Digital twin mappings
// ====================================================================

digital_twin_mapping BatteryGauge_DT {
    physical_entity: "The Battery tide gauge CO-OPS 8518750",
    digital_entity: COOPS_BatteryMonthly,
    sync_mode: scheduled,
    sensors: [water_level],
    actuators: [],
}
digital_twin_mapping NYOFS_DT {
    physical_entity: "NYOFS operational ROMS forecast",
    digital_entity: NYOFS_ROMSSSH,
    sync_mode: real_time,
    sensors: [zeta, u, v],
    actuators: [],
}
digital_twin_mapping EEZ_DT {
    physical_entity: "United States exclusive economic zone",
    digital_entity: WorldEEZ_v12,
    sync_mode: on_demand,
    sensors: [],
    actuators: [],
}
digital_twin_mapping TidalFlat_DT {
    physical_entity: "GTF30 tidal-flat inventory 2020",
    digital_entity: GTF30_TidalFlat2020,
    sync_mode: scheduled,
    sensors: [tidal_flat_extent],
    actuators: [],
}

// ====================================================================
// Rules and policy packages
// ====================================================================

rule ConnectivityFloodRule {
    description: "a cell is inundated only if a 4-connected path at or below the water level reaches the sea",
    reference: ConnectivityFlood,
    applies_to: CZ.CP.INUNDATION.CONNECTIVITY
}
rule SumPreservingPopulationRule {
    description: "population is aggregated onto the source GHSL grid and never resampled",
    reference: PopulationExposure,
    applies_to: CZ.CC.EXPOSURE.POPULATION
}
policy_package NYHarborAdaptation {
    description: "return-period-based adaptation triggers for the harbor",
    reference: NewYorkHarbor_CompoundFlood,
    land_use: WorldEEZ_v12
}
