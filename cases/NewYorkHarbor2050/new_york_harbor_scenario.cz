}
data_source GTF30_TidalFlat2020 {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2020,
    resolution: 30.0 * meter,
    format: GeoTIFF,
    url: "data/webdata/raw/ecosystem/GTF30_2020maps_W75N45.tif",
    classification: CZ.WD.TIDALFLAT.GEOMORPHOLOGY,
}
data_source GSW_Occurrence {
    source_type: remote_sensing,
