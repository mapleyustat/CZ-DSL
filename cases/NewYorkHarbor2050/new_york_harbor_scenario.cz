// CZ-DSL - New York Harbor coastal-zone scenario
// Generated by tools/nyh_case/s4_scenario.py from data/webdata.
// Every numeric value below is read from the derived s1-s3 results.
// Do not edit by hand; regenerate instead.

// ====================================================================
// Spatial reference system
// ====================================================================

spatial_reference_system NYHarbor_SRM {
    geographic_crs: EPSG_4326,
    vertical_datum: EGM2008_geoid,
    tidal_datum: COOPS_station_datum,
    water_level_datum: MSL_anomaly,
    extent: -74.0, 40.0, -73.0, 41.0,
    cell_size: 90.0 * meter
}

// ====================================================================
// Scenario declaration
// ====================================================================

scenario NewYorkHarbor_CompoundFlood {
    description: "Compound sea-level-rise and storm-surge exposure, New York Harbor and Jamaica Bay",
    spatial_ref: NYHarbor_SRM,
    time_horizon: 2025-2100,
    reference_epoch: 2025,
    slr_trend: 5.28 * mm/year,
    slr_2050: 0.1320 * meter,
    slr_2100: 0.3961 * meter,
    return_level_100yr: 2.599 * meter,
    return_level_500yr: 2.995 * meter,
    observed_record: 3.294 * meter,
    observed_record_year: 2012
}

// ====================================================================
// Coastal database - thematic layer inventory
// ====================================================================

coastal_database NewYorkHarborCZDB {
    id: "CZDB-NYH-001",
    version: "1.0.0",
    spatial: NYHarbor_SRM,
    temporal: Scenario_2025_2100,
    tiling: CZDB_TileScheme_90m,
    cdb_profile: OGC_CDB_1_0,

    metadata: {
        title: "New York Harbor coastal-zone database",
        region: "New York Harbor and Jamaica Bay, USA",
        provider: "Coastal Systems Lab",
        extent_km2: 9423,
        land_km2: 2659,
        water_km2: 6764,
        layers: 14,
        datasets: 16
    },

    layers: {
        elevation: layer {
            type: BathymetryLayer,
            cdb_dataset: CDB_D300_S002_T001,
            cdb_geometry_type: CDB_Terrain_Elevation,
            datasets: {
                copdem90_dem: dataset {
                    feature_class: GriddedElevation,
                    spatial_resolution: 90.0 * meter,
                    quality_profile: CopernicusDEM_QC2,
                    uncertainty_model: ElevationUncertainty_RMSE,
                    cmecs_unit: CMECS_Substrate_Unit
                }
            }
        },
        hydrodynamics: layer {
            type: HydrodynamicsLayer,
            cdb_dataset: CDB_D300_S003_T001,
            cdb_geometry_type: CDB_Terrain_Grid,
            datasets: {
                nyofs_roms_grid: dataset {
                    feature_class: ROMSCurvilinearGrid,
                    spatial_resolution: 1000.0 * meter,
                    quality_profile: OperationalModel_QC1,
                    uncertainty_model: EnsembleSpread,
                    cmecs_unit: CMECS_Water_Column_Unit
                }
            }
        },
        water_level: layer {
            type: WaterLevelLayer,
            cdb_dataset: CDB_D402_S002_T001,
            cdb_geometry_type: CDB_Vector_Point,
            datasets: {
                battery_gauge_monthly: dataset {
                    feature_class: TideGaugeStatistics,
                    temporal_resolution: 1.0 * hour,
                    quality_profile: TidalStatistics_QC1,
                    uncertainty_model: GaugeCalibrationError,
                    cmecs_unit: CMECS_Water_Column_Unit
                },
                psmsl_rlr_annual: dataset {
                    feature_class: SeaLevelIndex,
                    temporal_resolution: 1.0 * year,
                    quality_profile: GlobalNetwork_QC1,
                    uncertainty_model: LinearTrendStdError,
                    cmecs_unit: CMECS_Water_Column_Unit
                }
            }
        },
        surge_extremes: layer {
            type: ExtremesLayer,
            cdb_dataset: CDB_D402_S003_T001,
            cdb_geometry_type: CDB_Vector_Point,
            datasets: {
                codec_gumbel_stations: dataset {
                    feature_class: ExtremeValueStation,
                    quality_profile: PeerReviewed_QC1,
                    uncertainty_model: GumbelConfidenceInterval,
                    cmecs_unit: CMECS_Water_Column_Unit
                }
            }
        },
        tidal_flat: layer {
            type: HabitatLayer,
            cdb_dataset: CDB_D201_S001_T001,
            cdb_geometry_type: CDB_Vector_Polygon,
            datasets: {
                gtf30_tidal_flat_2020: dataset {
                    feature_class: TidalFlatPolygon,
                    spatial_resolution: 30.0 * meter,
                    quality_profile: GlobalClassification_QC2,
                    uncertainty_model: CategoricalConfusionMatrix,
                    cmecs_unit: CMECS_Geoform_Unit
                }
            }
        },
        population: layer {
            type: SocioeconomicLayer,
            cdb_dataset: CDB_D501_S001_T001,
            cdb_geometry_type: CDB_Vector_Point,
            datasets: {
                ghsl_population_2020: dataset {
                    feature_class: PopulationGrid,
                    spatial_resolution: 0.008333 * degree,
                    quality_profile: CensusDisaggregated_QC2,
                    uncertainty_model: DasymetricUncertainty,
                    cmecs_unit: CMECS_Anthro_Unit
                }
            }
        },
        jurisdiction: layer {
            type: GovernanceLayer,
            cdb_dataset: CDB_D402_S004_T001,
            cdb_geometry_type: CDB_Vector_Polygon,
            datasets: {
                world_eez_v12: dataset {
                    feature_class: ExclusiveEconomicZone,
                    spatial_resolution: 1000.0 * meter,
                    quality_profile: AuthoritativeMaritime_QC1,
                    uncertainty_model: BoundaryPositionalError,
                    cmecs_unit: CMECS_Jurisdiction_Unit
                }
            }
        },
        shoreline: layer {
            type: ShorelineLayer,
            cdb_dataset: CDB_D402_S001_T001,
            cdb_geometry_type: CDB_Vector_Line,
            datasets: {
                gsw_occurrence: dataset {
                    feature_class: SurfaceWaterOccurrence,
                    spatial_resolution: 30.0 * meter,
                    temporal_resolution: 1.0 * year,
                    quality_profile: LandsatArchive_QC2,
                    uncertainty_model: OccurrenceFrequency,
                    cmecs_unit: CMECS_Geoform_Unit
                }
            }
        },
        waves: layer {
            type: WavesLayer,
            cdb_dataset: CDB_D300_S004_T001,
            cdb_geometry_type: CDB_Terrain_Grid,
            datasets: {
                marine_wave_series: dataset {
                    feature_class: WaveHeightSeries,
                    temporal_resolution: 1.0 * hour,
                    quality_profile: Reanalysis_QC2,
                    uncertainty_model: HindcastBias,
                    cmecs_unit: CMECS_Water_Column_Unit
                }
            }
        },
        wind: layer {
            type: MeteorologyLayer,
            cdb_dataset: CDB_D300_S005_T001,
            cdb_geometry_type: CDB_Terrain_Grid,
            datasets: {
                wind_series: dataset {
                    feature_class: WindFieldSeries,
                    temporal_resolution: 1.0 * hour,
                    quality_profile: Reanalysis_QC2,
                    uncertainty_model: HindcastBias,
                    cmecs_unit: CMECS_Water_Column_Unit
                }
            }
        },
        inundation: layer {
            type: InundationLayer,
            cdb_dataset: CDB_D300_S006_T001,
            cdb_geometry_type: CDB_Terrain_Elevation,
            datasets: {
                connectivity_flood: dataset {
                    feature_class: InundationDepthSurface,
                    spatial_resolution: 90.0 * meter,
                    quality_profile: DerivedProduct_QC3,
                    uncertainty_model: ConnectivityAssumption,
                    cmecs_unit: CMECS_Geoform_Unit
                }
            }
        },
        exposure: layer {
            type: ExposureLayer,
            cdb_dataset: CDB_D501_S002_T001,
            cdb_geometry_type: CDB_Vector_Polygon,
            datasets: {
                habitat_exposure: dataset {
                    feature_class: HabitatExposureSurface,
                    spatial_resolution: 90.0 * meter,
                    quality_profile: DerivedProduct_QC3,
                    uncertainty_model: AreaWeightingUncertainty,
                    cmecs_unit: CMECS_Biotic_Unit
                },
                population_exposure: dataset {
                    feature_class: PopulationExposureSurface,
                    spatial_resolution: 0.008333 * degree,
                    quality_profile: DerivedProduct_QC3,
                    uncertainty_model: SumPreservationCheck,
                    cmecs_unit: CMECS_Anthro_Unit
                }
            }
        },
        imagery: layer {
            type: ImageryLayer,
            cdb_dataset: CDB_D100_S001_T001,
            cdb_geometry_type: CDB_Raster_Imagery,
            datasets: {
                modis_annual_truecolor: dataset {
                    feature_class: SatelliteImagery,
                    spatial_resolution: 250.0 * meter,
                    temporal_resolution: 1.0 * year,
                    quality_profile: ArchiveProduct_QC2,
                    uncertainty_model: AtmosphericCorrectionError,
                    cmecs_unit: CMECS_Biotic_Unit
                }
            }
        },
        cross_subject: layer {
            type: CrossSubjectLayer,
            cdb_dataset: CDB_D700_S001_T001,
            cdb_geometry_type: CDB_Vector_Line,
            datasets: {
                stakeholder_links: dataset {
                    feature_class: CrossSubjectLinkSet,
                    quality_profile: GovernanceMapping_QC3,
                    uncertainty_model: StakeholderCoverage,
                    cmecs_unit: CMECS_Anthro_Unit
                }
            }
        },
    }
}

// ====================================================================
// Data sources - 16 real inputs
// ====================================================================

data_source CopernicusDEM_GLO90 {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: static,
    resolution: 90.0 * meter,
    format: GeoTIFF,
    url: "data/webdata/raw/dem/copdem90_long_island.tif",
    classification: CZ.CP.BATHYMETRY.GRID,
}
data_source NYOFS_ROMSSSH {
    source_type: simulation,
    coordinate_ref: EPSG_4326,
    temporal_ref: hourly,
    resolution: 1000.0 * meter,
    format: NetCDF,
    url: "data/webdata/raw/coastal_models/nyofs.nc",
    classification: CZ.CP.HYDRODYNAMICS.ROMS,
}
data_source COOPS_BatteryMonthly {
    source_type: observation,
    coordinate_ref: COOPS_station_datum,
    temporal_ref: 1980-2024,
    format: JSON,
    url: "data/webdata/raw/tide/coops_monthly_8518750.json",
    classification: CZ.CP.WATERLEVEL.GAUGE,
}
data_source COOPS_BatteryHourly {
    source_type: observation,
    coordinate_ref: COOPS_station_datum,
    temporal_ref: 2024-01,
    resolution: 1.0 * hour,
    format: JSON,
    url: "data/webdata/raw/tide/coops_8518750.json",
    classification: CZ.CP.WATERLEVEL.GAUGE,
}
data_source COOPS_MontaukMonthly {
    source_type: observation,
    coordinate_ref: COOPS_station_datum,
    temporal_ref: 1980-2024,
    format: JSON,
    url: "data/webdata/raw/tide/coops_monthly_8510560.json",
    classification: CZ.CP.WATERLEVEL.GAUGE,
}
data_source PSMSL_RLR_Annual {
    source_type: observation,
    coordinate_ref: RLR,
    temporal_ref: 1856-2025,
    resolution: 1.0 * year,
    format: ASCII,
    url: "data/webdata/raw/timeseries/sea_level/psmsl_rlr_annual.zip",
    classification: CZ.CP.WATERLEVEL.SEALEVEL,
}
data_source NOAASTAR_Altimetry {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 1992-2025,
    resolution: 1.0 * year,
    format: CSV,
    url: "data/webdata/raw/timeseries/sea_level/slr_sla_gbl_keep_ref_90.csv",
    classification: CZ.CP.WATERLEVEL.SEALEVEL,
}
data_source CoDEC_ExtremeSurge {
    source_type: simulation,
    coordinate_ref: EPSG_4326,
    temporal_ref: climatology,
    format: NetCDF,
    url: "data/webdata/raw/surge/codec_coastal_extremes.nc",
    classification: CZ.CP.HYDRODYNAMICS.SURGE,
}
data_source GTSR_SeasonalSurge {
    source_type: simulation,
    coordinate_ref: EPSG_4326,
