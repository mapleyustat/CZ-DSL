// CZ-DSL - Cyclone Idai coastal-zone scenario
// Generated by tools/regional/emit_cz.py from data/regional/derived/disaster.json.
// Every numeric value is read from that derived record, which is built only
// from files registered in data/regional/SOURCES.json. Do not edit by hand.
//
// Region: Coastal disasters
// Sources: 5 files, 97762043 bytes, 4 distinct providers.


// ====================================================================
// Spatial reference system
// A disaster is the case where the temporal reference is an event, not a
// calendar: the flood depth, the satellite extent and the track all refer
// to the same storm but were produced on different grids, in different
// projections and at different times within it. The event, not the epoch,
// is the join key.
// ====================================================================

spatial_reference_system Idai_SRM {
    geographic_crs: EPSG_4326,
    projected_crs: EPSG_32736,
    land_vertical_datum: Beira_local_datum,
    marine_vertical_datum: Beira_chart_datum,
    event_reference: Cyclone_Idai_2019-03-15_landfall,
    extent: 34.0, -20.5, 35.5, -19.0,
    cell_size: 5.0 * meter
}


scenario Idai_CompoundCoastalFlood {
    description: "One cyclone described at once by its track, by a modelled "
                 "flood depth, by a satellite flood extent, by a local gauge "
                 "and by the displacement record",
    spatial_ref: Idai_SRM,
    time_horizon: 2019-03-04..2019-03-16,
    reference_epoch: 2019,
    track_fixes: 101,
    max_wind: 105.0 * knot,
    min_pressure: 940.0 * hPa,
    flood_max_depth: 13.113 * meter,
    flood_p95_depth: 2.846 * meter,
    flood_deeper_than_1m: 0.5032,
    gfm_flooded_fraction: 0.9809,
    gauge_mean: 6949.6 * millimeter,
    comparison_storm: "Freddy (2023), 305 fixes, "
                      "125 kt"
}


coastal_database IdaiCZDB {
    id: "CZDB-DIS-001",
    version: "1.0.0",
    spatial: Idai_SRM,
    temporal: Event_Idai_2019,
    tiling: CZDB_TileScheme_5m,
    cdb_profile: OGC_CDB_1_0,
    metadata: {
        title: "Cyclone Idai coastal-zone database",
        region: "Beira and the Mozambique Channel",
        source_files: 5,
        source_bytes: 97762043,
        providers: 4,
        channel_storms: 277
    },
    layers: {
        hazard_track: layer {
            type: ProcessLayer,
            datasets: {
                ibtracs_si: dataset {
                    feature_class: TropicalCycloneTrack,
                    temporal_resolution: 6.0 * hour,
                    channel_storms: 277,
                    cmecs_unit: CMECS_Process_Storm
                }
            }
        },
        flood_depth: layer {
            type: HazardLayer,
            datasets: {
                idai_hmax: dataset {
                    feature_class: ModelledFloodDepth,
                    spatial_resolution: 5.0 * meter,
                    scenario: "high tide + rain + surge, with retreat",
                    max_depth: 13.113 * meter,
                    caveat: "",
                    cmecs_unit: CMECS_Process_Inundation
                }
            }
        },
        observed_extent: layer {
            type: HazardLayer,
            datasets: {
                gfm_s1: dataset {
                    feature_class: ObservedFloodExtent,
                    spatial_resolution: 20.0 * meter,
                    sensor: Sentinel_1_SAR,
                    acquisition: 2019-03-24T16:22:50Z,
                    cmecs_unit: CMECS_Process_Inundation
                }
            }
        }
    }
}


data_source IBTrACS_SouthIndian {
    source_type: observation,
    coordinate_ref: WGS84_geodetic,
    temporal_ref: 1848-2026,
    temporal_resolution: 6_hourly,
    format: CSV,
    url: "data/regional/raw/dis_ibtracs_si/ibtracs_SI_v04r01.csv",
    note: "2887 storms; Idai is 2019063S18038 with 101 fixes",
    classification: CZ.CC.HAZARD.CYCLONE,
}


data_source Idai_ModelledDepth {
    source_type: simulation,
    coordinate_ref: EPSG_32736,
    temporal_ref: 2019-03-15..2019-03-24,
    temporal_resolution: event_maximum,
    format: TIFF,
    url: "data/regional/raw/dis_idai_flooddepth/idai_beira_hmax_retreat.tiff",
    note: "an event maximum, not a time series, so it carries no cadence and cannot be differenced",
    classification: CZ.CC.HAZARD.FLOOD_DEPTH,
}


data_source GFM_Sentinel1_Extent {
    source_type: remote_sensing,
    coordinate_ref: EPSG_4326,
    temporal_ref: 2019-03-24,
    temporal_resolution: single_acquisition,
    format: TIF,
    url: "data/regional/raw/dis_gfm_flood/gfm_flood_idai_20190324.tif",
    note: "Sentinel-1 era only, so this archive cannot cover Haiyan or Katrina even though they are in the track record",
    classification: CZ.CC.HAZARD.FLOOD_EXTENT,
}


data_source PSMSL_Maputo {
    source_type: observation,
    coordinate_ref: Maputo_station_datum,
    temporal_ref: 1961-2001,
    temporal_resolution: monthly,
    format: RLRDATA,
    url: "data/regional/raw/dis_psmsl_monthly/psmsl_maputo_986_monthly.rlrdata",
    note: "monthly means 197; the gauge is far from landfall",
    classification: CZ.CC.SEALEVEL.GAUGE,
}


// ====================================================================
// Cross-subject links
// ====================================================================

cross_subject_link TrackToFloodDepth {
    source: IBTrACS_SouthIndian,
    target: Idai_ModelledDepth,
    link_type: data_flow,
    relation_kind: r_T,
    temporal_lag: 0.0 * hour,
    variables: [track_lat, track_lon, max_wind, min_pressure],
    coupling_interval: per_event,
    event_identity: Cyclone_Idai_2019,
    note: "the modelled depth is forced by this track, so the two share an "
          "event identity rather than merely overlapping in time"
}

cross_subject_link DepthToObservedExtent {
    source: Idai_ModelledDepth,
    target: GFM_Sentinel1_Extent,
    link_type: validation,
    relation_kind: r_S,
    spatial_predicate: overlaps,
    variables: [flood_depth, flood_extent],
    sample_size: 2256116,
    note: "a modelled maximum against a single acquisition nine days after "
          "landfall; they are not contemporaneous and the comparison is "
          "reported with that gap attached"
}

cross_subject_link GaugeToFlood {
    source: PSMSL_Maputo,
    target: Idai_ModelledDepth,
    link_type: constraint,
    relation_kind: r_T,
    temporal_lag: -216.0 * hour,
    variables: [sea_level],
    coupling_interval: hourly,
    note: "the surge component of the modelled depth is bounded by the "
          "nearest gauge, which is far enough away that the bound is weak "
          "and is declared weak"
}

cross_subject_link FloodToDisplacement {
    source: Idai_ModelledDepth,
    target: GFM_Sentinel1_Extent,
    link_type: impact_chain,
    relation_kind: r_C,
    variables: [flood_depth, displacement],
    sample_size: 2256116,
    note: "the displacement record is the socio-economic end of the chain; "
          "the link is a correlation and is not used to attribute causation"
}

granularity IdaiGranularity {
    level: L3,
    spatial: 30.0 * meter,
    temporal: 1.0 * hour,
    note: "the depth grid is 5 m, the extent 20 m, the track 6-hourly; the "
          "declared level is the finest of the three and is not uniform"
}

classification_layer IdaiClassification {
    scheme: CMECS,
    vocabulary: [CMECS_Process_Storm, CMECS_Process_Inundation],
    crosswalk: "the Copernicus EMS grading classes (flooded, destroyed, "
               "damaged) do not map onto CMECS biota or substrate and are "
               "carried as a third unmapped facet"
}
